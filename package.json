{
  "name": "elite-dev-verzel",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace @elite-dev/web",
    "dev:api": "npm run dev --workspace @elite-dev/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run prisma:generate && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run prisma:generate && npm run build --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prisma:validate": "npm run prisma:validate --workspace @elite-dev/api",
    "prisma:generate": "npm run prisma:generate --workspace @elite-dev/api",
    "db:up": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:check": "npm run db:check --workspace @elite-dev/api",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @elite-dev/api --",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @elite-dev/api",
    "db:seed": "npm run db:seed --workspace @elite-dev/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
