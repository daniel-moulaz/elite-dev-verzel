generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ORGANIZER
  CUSTOMER
  GATE
}

enum SessionStatus {
  DRAFT
  PUBLISHED
}

enum ReservationStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  APPROVED
  DECLINED
}

enum TicketStatus {
  VALID
  USED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(120)
  email        String        @unique @db.VarChar(320)
  passwordHash String        @db.VarChar(255)
  role         Role
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  sessions     Session[]
  reservations Reservation[] @relation("CustomerReservations")
  tickets      Ticket[]      @relation("TicketOwner")
  usedTickets  Ticket[]      @relation("TicketGate")
}

model Session {
  id                  String        @id @default(uuid()) @db.Uuid
  organizerId         String        @db.Uuid
  status              SessionStatus @default(DRAFT)
  startsAt            DateTime      @db.Timestamptz(3)
  venueName           String        @db.VarChar(120)
  roomName            String        @db.VarChar(80)
  address             String        @db.VarChar(240)
  priceCents          Int
  tmdbMovieId         Int
  movieTitle          String        @db.VarChar(240)
  movieOverview       String        @db.Text
  moviePosterPath     String?       @db.VarChar(255)
  movieBackdropPath   String?       @db.VarChar(255)
  movieReleaseDate    DateTime?     @db.Date
  movieRuntimeMinutes Int?
  publishedAt         DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  organizer           User          @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  seats               Seat[]
  reservations        Reservation[]
  tickets             Ticket[]

  @@index([status, startsAt])
  @@index([organizerId, startsAt])
}

model Seat {
  id              String           @id @default(uuid()) @db.Uuid
  sessionId       String           @db.Uuid
  rowLabel        String           @db.VarChar(1)
  number          Int              @db.SmallInt
  label           String           @db.VarChar(3)
  session         Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reservationSeat ReservationSeat?

  @@unique([sessionId, label])
}

model Reservation {
  id         String            @id @default(uuid()) @db.Uuid
  customerId String            @db.Uuid
  sessionId  String            @db.Uuid
  status     ReservationStatus @default(PENDING)
  expiresAt  DateTime          @db.Timestamptz(3)
  totalCents Int
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  customer   User              @relation("CustomerReservations", fields: [customerId], references: [id], onDelete: Restrict)
  session    Session           @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  seats      ReservationSeat[]
  payment    Payment?

  @@index([customerId, createdAt])
  @@index([sessionId, status, expiresAt])
}

model ReservationSeat {
  id             String      @default(uuid()) @unique @db.Uuid
  reservationId  String      @db.Uuid
  seatId         String      @unique @db.Uuid
  unitPriceCents Int
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  seat           Seat        @relation(fields: [seatId], references: [id], onDelete: Restrict)
  ticket         Ticket?

  @@id([reservationId, seatId])
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  reservationId String        @unique @db.Uuid
  status        PaymentStatus
  amountCents   Int
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Restrict)
}

model Ticket {
  id                String            @id @default(uuid()) @db.Uuid
  reservationSeatId String            @unique @db.Uuid
  sessionId         String            @db.Uuid
  ownerId           String            @db.Uuid
  status            TicketStatus      @default(VALID)
  manualCode        String            @unique @db.VarChar(19)
  issuedAt          DateTime          @default(now()) @db.Timestamptz(3)
  usedAt            DateTime?         @db.Timestamptz(3)
  usedByGateId      String?           @db.Uuid
  reservationSeat   ReservationSeat   @relation(fields: [reservationSeatId], references: [id], onDelete: Restrict)
  session           Session           @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  owner             User              @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  usedByGate        User?             @relation("TicketGate", fields: [usedByGateId], references: [id], onDelete: Restrict)
  sharedLink        SharedTicketLink?

  @@index([ownerId, issuedAt])
  @@index([sessionId, status])
}

model SharedTicketLink {
  id        String    @id @default(uuid()) @db.Uuid
  ticketId  String    @unique @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}
